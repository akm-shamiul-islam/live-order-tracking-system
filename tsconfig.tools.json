{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "scripts/**/*.ts",
    "backend/scripts/**/*.ts",
    "frontend/scripts/**/*.ts",
    "vitest*.ts"
  ]
}
