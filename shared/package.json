{
  "name": "@kitchentodoor/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/zod.ts",
    "./dist/zod.js"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./zod": {
      "types": "./src/zod.ts",
      "development": "./src/zod.ts",
      "default": "./dist/zod.js"
    },
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
