{
  "name": "kitchen-to-door",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Food Order Tracking & Telemetry Platform: From Restaurant Kitchen to Customer Doorstep",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:backend": "pnpm --filter @kitchentodoor/backend dev",
    "dev:frontend": "pnpm --filter @kitchentodoor/frontend dev",
    "auth:reset-dev-admin": "pnpm --filter @kitchentodoor/backend auth:reset-dev-admin",
    "auth:bootstrap-admin": "pnpm --filter @kitchentodoor/backend auth:bootstrap-admin",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @kitchentodoor/backend exec tsx --conditions=development scripts/copy-receipt-assets.ts && vitest run --config vitest.integration.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "deps:check": "node scripts/check-dependencies.ts",
    "benchmark:throughput": "node scripts/benchmark-throughput.ts",
    "audit:lighthouse": "node scripts/audit-lighthouse.ts",
    "test:browser": "pnpm build && pnpm --filter @kitchentodoor/backend exec tsx ../scripts/verify-browser.ts",
    "test:browser:profiles": "pnpm build && pnpm --filter @kitchentodoor/backend exec tsx ../scripts/verify-profiles.ts",
    "source:check": "node scripts/check-source-language.ts",
    "locales:check": "node scripts/check-locales.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck": "pnpm source:check && pnpm locales:check && pnpm -r typecheck && pnpm typecheck:tools",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^24.19.2",
    "devtools-protocol": "0.0.1724436",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "oxc-parser": "0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "oxlint --fix --config .oxlintrc.staged.json",
      "oxfmt"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.14.0"
}
