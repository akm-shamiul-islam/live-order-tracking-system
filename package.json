{
  "name": "kitchen-to-door",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Food Order Tracking & Telemetry Platform: From Restaurant Kitchen to Customer Doorstep",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:backend": "pnpm --filter @kitchentodoor/backend dev",
    "dev:frontend": "pnpm --filter @kitchentodoor/frontend dev",
    "auth:reset-dev-admin": "pnpm --filter @kitchentodoor/backend auth:reset-dev-admin",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "deps:check": "node scripts/check-dependencies.mjs",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.14.0"
}
