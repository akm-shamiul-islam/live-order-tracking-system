# =====================================================================
# KitchenToDoor - Environment Configuration
# =====================================================================

# Server Environment & Ports
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Optional separate API host for Vite development and preview proxies:
# API_PROXY_TARGET=http://127.0.0.1:5000

# =====================================================================
# Database (MongoDB)
# =====================================================================
# Insert your MongoDB Atlas or local connection string below:
MONGODB_URI=mongodb://localhost:27017/kitchentodoor_db

# =====================================================================
# Security: generate a unique secret before starting the API
# =====================================================================
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Refresh tokens are not implemented; sign in again when the access token expires.

# =====================================================================
# Default Seed Credentials (development only; seeding is disabled in production)
# =====================================================================
# Keep passwords quoted: an unquoted # starts a dotenv comment.
# Admin account:
ADMIN_DEFAULT_EMAIL=admin@kitchentodoor.io
ADMIN_DEFAULT_PASSWORD="KitchenAdmin#2026!Secure"

# Courier account:
COURIER_DEFAULT_EMAIL=courier@kitchentodoor.io
COURIER_DEFAULT_PASSWORD="Courier#2026!Speed"

# =====================================================================
# Runtime settings (timeouts/windows are milliseconds)
# =====================================================================
API_HOST=0.0.0.0
FRONTEND_PORT=5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_TTL_MS=60000
REGISTER_RATE_LIMIT_MAX=5
PASSWORD_HASH_ROUNDS=12
ORDER_LIST_DEFAULT_LIMIT=50
ORDER_LIST_MAX_LIMIT=100
ORDER_HISTORY_LIMIT=20
ORDER_ESTIMATE_MINUTES=35
DELIVERY_FEE=5
TAX_RATE=0.08
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_RETRY_ATTEMPTS=9
MONGODB_RETRY_DELAY_MS=3000
# Optional DNS override; leave empty to use system resolvers.
DNS_SERVERS=8.8.8.8,1.1.1.1

# Public browser settings: these are embedded in the frontend build.
# Restart Vite after editing them; rebuild to change production assets.
VITE_REQUEST_TIMEOUT_MS=15000
VITE_QUERY_STALE_TIME_MS=30000
VITE_QUERY_RETRY_COUNT=1
VITE_SESSION_STALE_TIME_MS=60000
VITE_SOCKET_ACK_TIMEOUT_MS=5000
VITE_SOCKET_RECONNECT_ATTEMPTS=15
VITE_SOCKET_RECONNECT_DELAY_MS=1000
VITE_HEARTBEAT_INTERVAL_MS=4000
VITE_HEARTBEAT_TIMEOUT_MS=3000
VITE_SIMULATION_INTERVAL_MS=600
VITE_SIMULATION_STEP_PERCENT=5
