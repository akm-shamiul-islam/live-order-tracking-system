# =====================================================================
# KitchenToDoor - Environment Configuration
# =====================================================================

# Server Environment & Ports
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Optional separate API host for Vite development and preview proxies:
# API_PROXY_TARGET=http://127.0.0.1:5000

# =====================================================================
# Database (MongoDB)
# =====================================================================
# Insert your MongoDB Atlas or local connection string below:
MONGODB_URI=mongodb://localhost:27017/kitchentodoor_db

# =====================================================================
# Security: generate a unique secret before starting the API
# =====================================================================
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Opaque rotating refresh tokens use HttpOnly cookies and database hashes.
AUTH_SESSION_TTL_MS=604800000
AUTH_REFRESH_HISTORY_MAX=1000
# Set true for HTTPS production. Local HTTP development uses false.
AUTH_COOKIE_SECURE=false
REFRESH_RATE_LIMIT_MAX=30
RESET_RATE_LIMIT_MAX=5
RECEIPT_RATE_LIMIT_MAX=10
RECEIPT_TIME_ZONE=UTC
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_TRUSTED_DEVICES_MAX=20
OTP_REQUEST_RATE_LIMIT_MAX=5
OTP_VERIFY_RATE_LIMIT_MAX=10
PUBLIC_APP_URL=http://localhost:5173
# Account verification, new-device sign-in and password recovery require authenticated SMTP.
# Gmail setup is documented in documentation/docs/CONFIGURATION.md. Keep credentials in .env.
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-Google-App-Password
# SMTP_FROM=your-address@gmail.com
SMTP_FROM_NAME=KitchenToDoor

# =====================================================================
# Default Seed Credentials (development only; seeding is disabled in production)
# =====================================================================
# Keep passwords quoted: an unquoted # starts a dotenv comment.
# Admin account:
ADMIN_DEFAULT_EMAIL=admin@kitchentodoor.io
ADMIN_DEFAULT_PASSWORD="KitchenAdmin#2026!Secure"

# Courier account:
COURIER_DEFAULT_EMAIL=courier@kitchentodoor.io
COURIER_DEFAULT_PASSWORD="Courier#2026!Speed"

# =====================================================================
# Runtime settings (timeouts/windows are milliseconds)
# =====================================================================
API_HOST=0.0.0.0
# Trust only known reverse-proxy socket peers; leave empty for direct access.
TRUSTED_PROXY_IPS=
# Serve the built frontend, API and sockets from the API port in production.
SERVE_FRONTEND=false
STATIC_ASSET_MAX_AGE_SECONDS=3600
STATIC_HASHED_MAX_AGE_SECONDS=31536000
FRONTEND_PORT=5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_TTL_MS=60000
REGISTER_RATE_LIMIT_MAX=5
PASSWORD_HASH_ROUNDS=12
ORDER_LIST_DEFAULT_LIMIT=50
ORDER_LIST_MAX_LIMIT=100
ORDER_HISTORY_LIMIT=20
ORDER_ESTIMATE_MINUTES=35
KITCHEN_LATITUDE=40.7128
KITCHEN_LONGITUDE=-74.006
ORDER_NUMBER_RETRY_ATTEMPTS=5
DELIVERY_REQUESTS_MAX=100
USER_LIST_DEFAULT_LIMIT=10
USER_LIST_MAX_LIMIT=100
USER_MANAGEMENT_AUDIT_MAX=100
PROFILE_CHANGE_RATE_LIMIT_MAX=5
PROFILE_PHOTO_MAX_BYTES=2000000
PROFILE_PHOTO_MAX_PIXELS=20000000
PROFILE_PHOTO_SIZE=256
PROFILE_RECOVERY_INTERVAL_MS=15000
PROFILE_RECOVERY_BATCH_SIZE=50
HTTP_BODY_LIMIT_BYTES=4100000
TELEMETRY_MAX_AGE_MS=15000
TELEMETRY_MAX_FUTURE_MS=5000
SOCKET_RATE_LIMIT_WINDOW_MS=1000
SOCKET_RATE_LIMIT_MAX=50
SOCKET_IP_RATE_LIMIT_MAX=200
SOCKET_RATE_LIMIT_IPS_MAX=10000
SOCKET_ORDER_ROOMS_MAX=20
SOCKET_MAX_PAYLOAD_BYTES=16384
SOCKET_CONNECT_WINDOW_MS=60000
SOCKET_CONNECT_MAX=30
SOCKET_CONNECTIONS_MAX=2000
SOCKET_CONNECTIONS_PER_IP_MAX=20
DELIVERY_FEE=5
TAX_RATE=0.08
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_RETRY_ATTEMPTS=1
MONGODB_RETRY_DELAY_MS=3000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_MAX_POOL_SIZE=100
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_WRITE_TIMEOUT_MS=5000
HEALTHCHECK_TIMEOUT_MS=1000
# Optional DNS override; leave empty to use system resolvers.
DNS_SERVERS=

# One-time production first-admin provisioning. Leave unset during normal operation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Public browser settings: these are embedded in the frontend build.
# Restart Vite after editing them; rebuild to change production assets.
VITE_REQUEST_TIMEOUT_MS=15000
VITE_QUERY_STALE_TIME_MS=30000
VITE_QUERY_RETRY_COUNT=1
VITE_SESSION_STALE_TIME_MS=60000
VITE_ORDER_LIST_REFRESH_MS=15000
VITE_NOTIFICATIONS_POLL_MS=15000
VITE_SOCKET_ACK_TIMEOUT_MS=5000
VITE_SOCKET_RECONNECT_ATTEMPTS=15
VITE_SOCKET_RECONNECT_DELAY_MS=1000
VITE_HEARTBEAT_INTERVAL_MS=4000
VITE_HEARTBEAT_TIMEOUT_MS=3000
VITE_SIMULATION_INTERVAL_MS=600
VITE_SIMULATION_STEP_PERCENT=5
# Optional administrator-only demonstration controls; never used for real courier sharing.
VITE_ENABLE_COURIER_SIMULATOR=false
VITE_GPS_SEND_INTERVAL_MS=5000
VITE_GPS_TIMEOUT_MS=15000
