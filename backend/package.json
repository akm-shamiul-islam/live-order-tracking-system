{
  "name": "@kitchentodoor/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:reset-dev-admin": "tsx --conditions=development src/database/reset-dev-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.1",
    "@kitchentodoor/shared": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^12.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.2.0",
    "mongoose": "^9.11.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
